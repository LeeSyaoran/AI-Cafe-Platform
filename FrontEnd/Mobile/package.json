{
  "name": "aicafe-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AI Café — React Native (Android + iOS)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
