# ==============================================================================
# AI CAFÉ PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env để cấu hình hệ thống:
# cp Docker/.env.example .env
# ==============================================================================

# ==================== CƠ SỞ DỮ LIỆU (POSTGRESQL) ====================
POSTGRES_DB=aicafe
POSTGRES_USER=aicafe
POSTGRES_PASSWORD=aicafe_secret_2024
POSTGRES_PORT=5432

# ==================== BỘ NHỚ ĐỆM (REDIS) ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== BẢNG ĐIỀU KHIỂN PGADMIN ====================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@aicafe.vn
PGADMIN_DEFAULT_PASSWORD=admin123

# ==================== BẢO MẬT & JWT ====================
JWT_SECRET=aicafe_jwt_secret_key_2024_change_in_production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ==================== API GATEWAY & WEBSERVER ====================
API_GATEWAY_PORT=3000
FRONTEND_WEB_PORT=3001
NGINX_PORT=80

# ==================== CỔNG THANH TOÁN (PAYMENT GATEWAYS) ====================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ==================== TÍCH HỢP TRÍ TUỆ NHÂN TẠO (AI MODELS) ====================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_AI_MODEL=gpt-4o
