# AI Café Platform - Environment Variables Template
# Copy file này thành .env và điền các giá trị thực

# ==========================================
# AI SERVICES
# ==========================================

# OpenAI API Key (https://platform.openai.com/)
# Miễn phí $5 cho tài khoản mới
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (https://console.anthropic.com/)
# Dùng cho Claude AI
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ==========================================
# PAYMENT PROVIDERS - VNPay
# ==========================================

# Sandbox (miễn phí test)
# Truy cập: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=2VRTB9OR
VNPAY_HASH_SECRET=BBGHGFKIWOPHGFKEWUIDJWSIJTGVKSJ
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/return

# Production (cần đăng ký merchant thật)
# VNPAY_TMN_CODE=your-production-tmn-code
# VNPAY_HASH_SECRET=your-production-secret
# VNPAY_API_URL=https://pay.vnpay.vn/vpcpay.html

# ==========================================
# PAYMENT PROVIDERS - MoMo
# ==========================================

# Sandbox (miễn phí test)
# Truy cập: https://developers.momo.vn/
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_API_URL=https://sandbox.momodev.mobi

# Production
# MOMO_PARTNER_CODE=your-partner-code
# MOMO_ACCESS_KEY=your-access-key
# MOMO_SECRET_KEY=your-secret-key
# MOMO_API_URL=https://wappay.momo.vn

# ==========================================
# PAYMENT PROVIDERS - ZaloPay
# ==========================================

# Sandbox (miễn phí test)
# Truy cập: https://developers.zalopay.vn/
ZALOPAY_APP_ID=your-app-id
ZALOPAY_KEY1=your-key1
ZALOPAY_KEY2=your-key2

# ==========================================
# EMAIL (Notification Service)
# ==========================================

# Gmail SMTP (dùng App Password)
# Tạo tại: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@aicafe.vn

# ==========================================
# DATABASE
# ==========================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=aicafe
DB_USERNAME=aicafe
DB_PASSWORD=aicafe_secret_2024

# ==========================================
# REDIS
# ==========================================

REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# JWT
# ==========================================

JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRATION=3600
JWT_REFRESH_TOKEN_EXPIRATION=604800
